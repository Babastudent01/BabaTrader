# =============================================================================
# Trading Bot — Environment Variables Template
# =============================================================================
# Copy this file to config/.env and fill in your values.
# NEVER commit config/.env to version control.
# =============================================================================

# ── Kill Switch ───────────────────────────────────────────────────────────────
# Set to true to immediately halt all trading activity
KILL_SWITCH=false

# ── Data API Keys ─────────────────────────────────────────────────────────────
# Alpha Vantage (optional, free tier available)
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# FRED (Federal Reserve Economic Data, optional, free)
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# NewsAPI (optional, free tier available)
# Get your key at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# ── Interactive Brokers (IBKR) ────────────────────────────────────────────────
# TODO: Fill in when using IBKR broker adapter
# Requires TWS or IB Gateway running locally
IBKR_HOST=127.0.0.1
IBKR_PORT=7497              # 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper, 4001 = Gateway live
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=your_ibkr_account_id_here

# ── Saxo Bank ─────────────────────────────────────────────────────────────────
# TODO: Fill in when using Saxo broker adapter
# Requires Saxo OpenAPI developer account
SAXO_APP_KEY=your_saxo_app_key_here
SAXO_APP_SECRET=your_saxo_app_secret_here
SAXO_REDIRECT_URI=http://localhost:8080/callback
SAXO_BASE_URL=https://gateway.saxobank.com/sim/openapi   # sim = simulation, live = https://gateway.saxobank.com/openapi
SAXO_ACCOUNT_KEY=your_saxo_account_key_here

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
LOG_DIR=logs
